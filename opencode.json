{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=ypofadoecoreanwppmyt&read_only=false",
      "oauth": {
        "scope": "database:read database:write"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chrome", "--executable-path", "/usr/bin/brave-browser", "--headless"],
      "enabled": true
    }
  }
}
